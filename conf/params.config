/*
 * Config-time parameter defaults for NextITS
 *
 * Only parameters that must exist before the typed params block in main.nf is resolved belong here
 * (used by other configs, to derive defaults, or read by process definitions at include time)
 * All other defaults live in the typed params block in main.nf
 */

params {

    // Output (used by tracedir and timeline/report/trace/dag in nextflow.config)
    outdir   = "${launchDir}/results"
    tracedir = "${params.outdir}/pipeline_info"

    // Primers (primer_foverlap / primer_roverlap derived at config time)
    primer_forward = "TACACACCGCCCGTCG"     // ITS9mun
    primer_reverse = "CCTSCSCTTANTDATATGC"  // ITS4ngsUni
    primer_foverlap = params.primer_forward.length() - 2
    primer_roverlap = params.primer_reverse.length() - 2

    // Referenced in process publishDir directives (evaluated at include time)
    chunking_n  = null
    storagemode = "rellink"

    // Read by process definitions at include time (publishDir arguments, output declarations),
    // which are evaluated before the typed params block in main.nf is applied
    its_region    = "full"      // primer_trim publishDir path (subworkflows/itsx_subworkflow.nf)
    pe_merger     = "usearch"   // merge_pe version outputs (modules/Illumina_pe.nf)
    qc_polyglen   = 10          // merge_pe version outputs (modules/Illumina_pe.nf)
    preclustering = "none"      // merge_buckets publishDir `enabled:` (workflows/STEP2.nf)
    clustering    = "vsearch"   // merge_buckets publishDir `enabled:` (workflows/STEP2.nf)

    // Used by validation.monochromeLogs in nextflow.config
    monochrome_logs = false

}
