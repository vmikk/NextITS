// Container specifications
// (shared by Docker, Podman, Singularity, and Apptainer profiles)

process {

    // Container from Docker Hub
    // NB! do not add the `docker://` prefix
    //     Nextflow adds it automatically for Singularity and Apptainer, and the image is converted to the SIF format on the first run
    
    container = 'vmikk/nextits:1.2.4'

    // OptimOTU processes (`--clustering optimotu`) run in a separate container
    // (keep this after the main `container` line, CI takes the first match)
    withLabel: 'optimotu' {
        container = 'vmikk/optimotu-nf:0.4.0'
    }

    // Local Singularity/Apptainer image file (e.g., on HPC nodes without internet access)
    // (three slashes are required for an absolute path)
    // container = 'file:///path/to/local/file/nextits-1.2.4.sif'

}
