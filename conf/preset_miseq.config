/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Preset for paired-end short reads with continuous Phred scores
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Four-colour chemistry, full-resolution quality scores (e.g., Illumina MiSeq, HiSeq 2500)
    No poly-G tails are expected

    Use as follows:
        nextflow run vmikk/NextITS -profile miseq,<docker/singularity> ...

    Parameters specified on the command line take precedence over these values
    NB. the values are provisional (not yet tuned on MiSeq data)
----------------------------------------------------------------------------------------
*/

params {
    seqplatform  = "Illumina"
    qc_binned    = false

    // No poly-G trimming
    qc_polyglen  = null

    // QC of merged reads
    qc_maxee     = 1
    qc_maxeerate = 0.01

    // Read merging
    pe_maxdiffs  = 10
    pe_pctid     = 80
}
